if [ -z "$1" ]; then
    echo "cannot pass empty arguments into container creator" >&2
    exit 1
elif podman pod exists debian && podman container exists "$1"; then
    echo "Pod $1 already exist. Doing nothing." >&2
else
    podman pod create --name debian -p 8080:8080

    podman run -d --init --pod debian --name "$1" debian:stable sleep infinity
    
    podman run --rm -it "$(podman inspect "$1" --format '{{.Config.Image}}')" /bin/bash -c "useradd -m -s /bin/bash user && usermod -aG sudo user && passwd user"

fi

